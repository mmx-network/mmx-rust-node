worker_processes 2;
pid /tmp/mmx-apps/nginx.pid;
error_log stderr warn;

events {
    worker_connections ${NGINX_WORKER_CONNECTIONS};
}

http {
    include /etc/nginx/mime.types;
    types { application/manifest+json webmanifest; }
    default_type application/octet-stream;
    # nginx's empty log filename uses the inherited stderr descriptor directly.
    # VM consoles can be writable through inherited FDs but forbid reopening
    # /dev/stdout or /dev/stderr after the supervisor drops privileges.
    access_log "" combined;
    server_tokens off;
    charset utf-8;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 0;
    client_header_timeout 5s;
    client_body_timeout 5s;
    send_timeout 15s;
    # Only the private HAProxy socket can supply the address used in logs.
    set_real_ip_from unix:;
    real_ip_header X-Mmx-Client;
    client_max_body_size 1k;
    client_body_temp_path /tmp/mmx-apps/client;
    proxy_temp_path /tmp/mmx-apps/proxy;
    fastcgi_temp_path /tmp/mmx-apps/fastcgi;
    uwsgi_temp_path /tmp/mmx-apps/uwsgi;
    scgi_temp_path /tmp/mmx-apps/scgi;

    # Precompressed at build time, with no compression CPU work per request.
    gzip_static on;
    # CDNs and reverse proxies send Via; nginx disables gzip for them by default.
    gzip_proxied any;
    gzip_vary on;

    # Only successful content-addressed assets get a long cache lifetime.
    # In particular, a CDN must never keep a missing asset or an error page.
    map "$status:$uri" $cache_control {
        default "no-cache";
        ~^[45] "no-store";
        ~:/healthz$ "no-store";
        ~^(200|206|304):/assets/ "public, max-age=31536000, immutable";
    }

    server {
        listen unix:/tmp/mmx-apps/nginx.sock default_server;
        server_name _;
        add_header Cache-Control "no-store" always;
        location = /healthz {
            default_type text/plain;
            return 200 "ok\n";
        }
        location / { return 404; }
    }

    server {
        listen unix:/tmp/mmx-apps/nginx.sock;
        server_name ${WALLET_HOST};
        root /srv/mmx/wallet;
        # These locations provide their complete policy because nginx drops
        # inherited add_header directives as soon as a location adds one.
        location = /connect.html {
            include /etc/nginx/mmx/wallet-connect-headers.conf;
            add_header Cache-Control $cache_control always;
            try_files $uri =404;
        }
        location = /wallet-sdk.js {
            include /etc/nginx/mmx/wallet-sdk-headers.conf;
            add_header Cache-Control $cache_control always;
            try_files $uri =404;
        }
        location /assets/sdk/ {
            include /etc/nginx/mmx/wallet-sdk-asset-headers.conf;
            add_header Cache-Control $cache_control always;
            try_files $uri =404;
        }
        include /etc/nginx/mmx/wallet-headers.conf;
        add_header Cache-Control $cache_control always;
        include /etc/nginx/mmx/locations.conf;
    }

    server {
        listen unix:/tmp/mmx-apps/nginx.sock;
        server_name ${EXPLORER_HOST};
        root /srv/mmx/explorer;
        include /etc/nginx/mmx/explorer-headers.conf;
        add_header Cache-Control $cache_control always;
        include /etc/nginx/mmx/locations.conf;
    }

    server {
        listen unix:/tmp/mmx-apps/nginx.sock;
        server_name ${WEBSITE_HOST} ${WEBSITE_WWW_HOST};
        root /srv/mmx/website;
        include /etc/nginx/mmx/website-headers.conf;
        add_header Cache-Control $cache_control always;
        include /etc/nginx/mmx/locations.conf;
    }
}
