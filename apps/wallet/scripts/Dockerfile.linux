# Linux desktop build environment (deb + AppImage) for the MMX Wallet.
# The first layers match the Gigahost desktop image so the build cache is shared.
FROM ubuntu:22.04
ARG RUST_VERSION=1.97.0
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential curl ca-certificates git pkg-config file patchelf python3 xz-utils \
    libwebkit2gtk-4.1-dev libgtk-3-dev libxdo-dev libayatana-appindicator3-dev librsvg2-dev \
    libfuse2 xvfb xauth dbus-x11 fonts-dejavu-core xdg-utils desktop-file-utils && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:/usr/local/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --profile minimal --default-toolchain ${RUST_VERSION} && rm /tmp/rustup.sh
ARG NODE_VERSION=24.18.1
RUN curl --proto '=https' --tlsv1.2 -fsS https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && rm /tmp/node.tar.xz
ENV APPIMAGE_EXTRACT_AND_RUN=1
# Checks of the built app under Xvfb: screenshots, window automation, WebDriver
# for its webview (tauri-driver + WebKitWebDriver); rsync for staging copies.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    x11-apps x11-utils xdotool rsync webkit2gtk-driver && rm -rf /var/lib/apt/lists/*
RUN CARGO_INCREMENTAL=0 nice -n 19 ionice -c 3 cargo install tauri-driver --version 2.0.6 --locked --jobs 2 --root /usr/local \
    && rm -rf /opt/cargo/registry /opt/cargo/git
# Lints for the desktop crate, which only builds here.
RUN rustup component add clippy
# Exercise window icon hints under an EWMH window manager.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    openbox && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp
