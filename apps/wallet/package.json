{
  "name": "mmx-wallet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.ts",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:mock": "vite --mode mock --host 127.0.0.1 --port 5173 --strictPort",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && vite build --mode web --outDir dist/web",
    "build:desktop": "npm run typecheck && vite build --mode desktop --outDir dist/desktop",
    "build:mock": "vite build --mode mock --outDir dist/mock",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/karla": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@preact/signals": "2.11.3",
    "@tauri-apps/api": "2.12.4",
    "preact": "10.29.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
